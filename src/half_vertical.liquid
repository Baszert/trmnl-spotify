    <div class="flex flex--col flex--left w--full">
      {% if top_tracks_raw.items %}
      {% for track in top_tracks_raw.items limit: 5 %}
      <div class="relative flex flex--left gap--large w--full">
        <div class="absolute rank bold aspect--1/1 bg--white text--black value--xxsmall w--6 rounded--full flex flex--col pt--1.5">{{ forloop.index }}</div>

        {% if track.album.images.size > 1 %}
        <img src="{{ track.album.images[1].url }}" class="rounded--xsmall image-dither w--16 lg:w--32">
        {% elsif track.album.images.size > 0 %}
        <img src="{{ track.album.images[0].url }}" class="rounded--xsmall image-dither w--16 lg:w--32">
        {% endif %}

        <div class="pt--1">
          <div class="label--small lg:value--xxsmall bold text-stroke text-stroke--white" data-clamp="1">{{ track.name }}</div>
          <div class="label--small text-stroke text-stroke--white">
            {% for artist in track.artists %}
            {% if forloop.last %}
            {{ artist.name }}
            {% else %}
            {{ artist.name }}, 
            {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
      {% endfor %}
      {% endif %}
    </div>
